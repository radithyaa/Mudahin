# Generated by Cargo
# will have compiled files and executables
/target/
/gen/schemas

# Build outputs Android (regenerable) — jangan commit.
/gen/android/.gradle/
/gen/android/build/
/gen/android/app/build/
/gen/android/local.properties

# APK/AAB hasil build — bagikan lewat GitHub Releases, bukan commit repo
# (berkas ~130 MB; demo cukup pakai yang dideploy / rilis).
/gen/android/artifacts/*.apk
/gen/android/artifacts/*.aab

# Keystore rilis bersifat rahasia; jangan pernah commit keystore produksi.
*.keystore
*.jks
