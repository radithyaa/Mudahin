# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url
BETTER_AUTH_URL=

# Origin web untuk CORS. Boleh beberapa dipisah koma (dev + produksi),
# karena web & server di-deploy ke origin *.workers.dev yang berbeda.
# @type=string
CORS_ORIGIN=

# Kunci API DeepSeek — hanya di Worker (Aturan Teknis §5.1).
# @type=string
DEEPSEEK_API_KEY=

# @type=url
# @defaultRequired=false
DEEPSEEK_BASE_URL=https://api.deepseek.com

# @type=string
# @defaultRequired=false
DEEPSEEK_MODEL=deepseek-chat

# Kunci API Gemini — khusus OCR tulisan tangan (Future F3, vision).
# Hanya di Worker (Aturan Teknis §5.1); fitur lain tetap memakai DeepSeek.
# @type=string
# @defaultRequired=false
GEMINI_API_KEY=

# Endpoint OpenAI-compatible Gemini (agar klien HTTP bisa dipakai bersama DeepSeek).
# @type=url
# @defaultRequired=false
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# @type=string
# @defaultRequired=false
GEMINI_MODEL=gemini-2.5-flash

# Token sederhana untuk memicu pra-panaskan cache AI (tugas demo).
# @type=string
# @defaultRequired=false
PREWARM_TOKEN=
