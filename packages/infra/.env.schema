# @import(../../apps/server/, pick=[NODE_ENV, CORS_ORIGIN, BETTER_AUTH_SECRET])
# @defaultRequired=false
# @defaultSensitive=true
# ---
ALCHEMY_PASSWORD=

# Kunci API DeepSeek — disuntikkan Alchemy ke Worker (Aturan Teknis §5.1).
# Nilai diambil dari file .env lokal (gitignored). Opsional agar stack tetap
# bisa dijalankan untuk pengembangan UI tanpa kunci; fitur AI akan menampilkan
# banner fallback bila kunci kosong (SRS §4.5).
# @type=string
DEEPSEEK_API_KEY=

# @type=url
DEEPSEEK_BASE_URL=https://api.deepseek.com

# @type=string
DEEPSEEK_MODEL=deepseek-chat

# Kunci API Gemini — khusus OCR tulisan tangan (Future F3, vision).
# Opsional agar stack tetap bisa dijalankan tanpa kunci; fitur OCR akan
# menampilkan banner fallback bila kunci kosong (SRS §4.5).
# @type=string
GEMINI_API_KEY=

# @type=url
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# @type=string
GEMINI_MODEL=gemini-2.5-flash

# Token untuk memicu pra-panaskan cache AI (tugas demo).
# @type=string
PREWARM_TOKEN=
